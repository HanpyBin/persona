[
  {
    "name": "iphone_status",
    "description": "List the user's iPhones the assistant may operate: those paired with one of the user's computers, with that computer turned on for it and the iPhone's own consent in its Persona app. For each: id, name, model, iOS version, the computer it is reached through, whether it is connected, locked and ready, what is missing (note), and what the iPhone says of itself now (detail: the app in front, the screen…). Changes nothing. `not_allowed` counts the iPhones that are paired but not allowed: only the user can allow them, on that iPhone.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "iphone_look",
    "description": "See one of the user's iPhones (one iphone_status lists): what is on its screen as numbered elements `[N]` (role, label, value), plus a screenshot. Act on them in iphone_do with `\"target\": N`; numbers stay valid in this conversation until the screen is read again. A long list is cut: pass `query` to keep only matching elements. Changes nothing. A locked iPhone shows only its lock screen: ask the user to unlock it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "description": "iPhone id or name from iphone_status; omit when there is only one"
        },
        "query": {
          "type": "string",
          "description": "keep only elements containing this (case-insensitive)"
        },
        "screenshot": {
          "type": "boolean",
          "description": "default true; false returns the elements only"
        }
      }
    }
  },
  {
    "name": "iphone_do",
    "description": "Act on one of the user's iPhones, in one call: `steps` in order, stopping at the first failure. Each step is `{\"action\": …}`: `tap` / `double_tap` / `long_press` {target: N from iphone_look, or x, y in screen points}, `swipe` {direction: up|down|left|right, target?} or {from: [x, y], to: [x, y]}, `type` {text, target?}, `press` {button: home|lock|volume_up|volume_down}, `launch` {app: name or bundle id}, `wait` {ms}. Add `observe: {}` to read the screen again after the last step; `timeout_ms` is the time for all of it (default 30000, at most 120000). A failure says whether anything reached the iPhone: when it may have, look with iphone_look before doing anything else. Read first with iphone_look when unsure what is on screen. Steps that pay, send, delete, sign in or change settings are asked on the user's phone first, and the user may also have asked to confirm every action: a refusal is the user's, so do not retry it and do not try to approve it yourself.",
    "input_schema": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "description": "iPhone id or name from iphone_status; omit when there is only one"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "actions in order: {\"action\": \"tap\", \"target\": 3}, {\"action\": \"type\", \"text\": \"…\"}"
        },
        "observe": {
          "type": "object",
          "description": "after the steps, read the screen again (iphone_look options; {} for defaults)"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "time for the steps, default 30000, max 120000"
        }
      }
    }
  }
]
